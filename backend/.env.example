# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# ─── Database ────────────────────────────────────────────────────────────────
# Railway provides this automatically as ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/gramsaathi_db

# ─── JWT Secrets (generate with: openssl rand -hex 64) ───────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# ─── AI APIs ─────────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Get free key at: https://aistudio.google.com
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Enable 2FA on Gmail, then create App Password at: myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
